# Snippet to ADD into the Lightsail instance's existing `default` nginx site
# (/etc/nginx/sites-available/default), inside its `server { listen 80; ... }`
# block — alongside the /realestate/ and /toeic/ locations already there.
# Do NOT create a separate sites-enabled file for this; the instance already
# has a single default_server on port 80 serving multiple apps by path.
#
# Placeholders to fill in during deployment:
#   <APP_PORT>  - the golf-app Express server's port (4002 by default, see
#                 server/src/index.ts / PORT env var)
#
# Basic auth setup (one-time, mirrors the existing /realestate/ protection):
#   sudo htpasswd /etc/nginx/.htpasswd golf   # prompts for a password; reuses
#                                              # the same htpasswd file as /realestate/
#
# location /golf/ {
#     auth_basic "Restricted";
#     auth_basic_user_file /etc/nginx/.htpasswd;
#
#     proxy_pass http://127.0.0.1:<APP_PORT>/;
#     proxy_http_version 1.1;
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
# }
#
# The trailing slash on both `location /golf/` and `proxy_pass .../`  strips
# the /golf/ prefix before forwarding, so the Express app (server/src/index.ts)
# doesn't need to know about it — it serves everything at its own root. The
# client build must still be built with VITE_BASE_PATH=/golf/ (see
# deploy/deploy.sh) so the browser's asset requests carry the /golf/ prefix.
#
# After adding the block: sudo nginx -t && sudo systemctl reload nginx
