# nginx config for serving the built SPA on the Lightsail instance.
#
# Install: sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/golf-app
#          sudo ln -s /etc/nginx/sites-available/golf-app /etc/nginx/sites-enabled/golf-app
#          sudo rm -f /etc/nginx/sites-enabled/default   # avoid the stock site colliding on port 80
#          sudo nginx -t && sudo systemctl reload nginx
#
# No domain is configured yet, so this serves plain HTTP on the instance's
# IP. If a domain is later pointed at this instance, switch to certbot
# (Let's Encrypt) and redirect :80 to :443.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /var/www/golf-app;
    index index.html;

    # SPA fallback: any path that isn't a real file resolves to index.html,
    # so client-side routing / deep links (e.g. a reload on a sub-page)
    # don't 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames from the Vite build are safe to cache
    # aggressively; index.html itself is not (it must always be revalidated
    # so a new deploy is picked up on next load).
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
